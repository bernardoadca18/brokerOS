# BrokerOS Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://brokeros:brokeros_dev@localhost:5432/brokeros

# Backend
ENVIRONMENT=development
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Security
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_SECURE_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
